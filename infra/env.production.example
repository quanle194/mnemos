# =====================================================================================================================
# Mnemos production environment template (single Ubuntu VPS, infra/docker-compose.prod.yml)
#
# Create the real file with generated secrets (never commit it; it is gitignored):
#     scripts/init-env.sh --output .env [--domain mnemos.example.com --acme-email ops@example.com]
# or copy this file to .env and replace every CHANGE_ME_GENERATED value with `openssl rand -hex 32`.
#
# Legend
#   [OPERATOR]  value only the operator can supply (domain, e-mail, provider credentials). Never invented by scripts.
#   [GENERATED] random internal secret; scripts/init-env.sh fills it with `openssl rand -hex 32`.
#   [DEFAULT]   safe default; change only when you know why.
#
# Compose reads this file for ${VAR} interpolation (--env-file) and also passes it to the app containers, so any
# backend setting from backend/app/config.py (case-insensitive) can be added here, e.g. WORKER_CONCURRENCY=8.
# Values are literal: do not quote, and do not use spaces around '='.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------- release
# Image tag deployed by scripts/deploy.sh (it rewrites this line after every successful deploy).
MNEMOS_VERSION=latest
# Image name prefix: `mnemos` for locally built images, or a registry path such as ghcr.io/acme/mnemos
# (then deploy with `scripts/deploy.sh --no-build --version <tag>`).
MNEMOS_IMAGE_PREFIX=mnemos

# ---------------------------------------------------------------------------------------------- edge / TLS
# [OPERATOR] A domain name (DNS A/AAAA record -> this VPS, ports 80+443 open) enables automatic HTTPS:
#   SITE_ADDRESS=mnemos.example.com
# ":80" serves plain HTTP only: use it on a private network/VPN or behind a TLS-terminating tunnel.
SITE_ADDRESS=:80
# [OPERATOR] Optional ACME account e-mail for certificate expiry notices (domain mode only). Leave empty to omit.
ACME_EMAIL=
# Host ports published by Caddy (the ONLY published ports). May include a bind address, e.g. 127.0.0.1:8080.
HTTP_PORT=80
HTTPS_PORT=443
# Edge request body limit (the API additionally enforces MAX_REQUEST_BYTES, default 256000 bytes).
MAX_REQUEST_BODY=2MB
# Proxies whose X-Forwarded-For is trusted by Caddy (e.g. a tunnel on the same host). Caddy syntax.
TRUSTED_PROXIES=private_ranges
# Route /mcp to the optional MCP server: set to "enabled" AND deploy with `--profile mcp` (scripts/deploy.sh --with-mcp).
MCP_ROUTE=disabled

# ---------------------------------------------------------------------------------------------- application
APP_ENV=production
LOG_LEVEL=INFO
# [OPERATOR] Public URLs as seen by browsers/agents. Domain mode: https://mnemos.example.com and .../api
PUBLIC_WEB_URL=http://localhost
PUBLIC_API_URL=http://localhost/api
# Dashboard and API share one origin (API under /api), so CORS is not needed. Comma-separated origins otherwise.
CORS_ALLOWED_ORIGINS=
# Comma-separated Host header allow-list for the API, e.g. mnemos.example.com ("*" = any). Compose appends
# localhost,127.0.0.1,api for internal health checks.
ALLOWED_HOSTS=*
# uvicorn worker processes for the API (each has its own DB pool and Prometheus registry).
API_WORKERS=2

# ---------------------------------------------------------------------------------------------- secrets
# [GENERATED] Hex only (keeps DATABASE_URL/REDIS_URL valid without URL-encoding).
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
REDIS_PASSWORD=CHANGE_ME_GENERATED
# [GENERATED] Protects POST /v1/admin/bootstrap (header X-Bootstrap-Secret). >= 24 chars; rotate freely.
API_BOOTSTRAP_SECRET=CHANGE_ME_GENERATED
# [GENERATED] HMAC pepper for stored API-key hashes. NEVER change after first deploy: it invalidates every API key.
API_KEY_PEPPER=CHANGE_ME_GENERATED

POSTGRES_USER=mnemos
POSTGRES_DB=mnemos

# ---------------------------------------------------------------------------------------------- AI providers
# fake   = deterministic built-in providers (no network, no credentials). Fine for smoke tests and evaluation only.
# openai = any OpenAI-compatible API (OpenAI, Azure OpenAI proxy, vLLM, LiteLLM, ...).
# ollama = local models (start the `ollama` profile: scripts/deploy.sh --with-ollama; base URL http://ollama:11434).
LLM_PROVIDER=fake
# [OPERATOR] e.g. https://api.openai.com/v1
LLM_BASE_URL=
# [OPERATOR] provider API key - never generated or guessed by scripts
LLM_API_KEY=
# [OPERATOR] e.g. gpt-4o-mini, llama3.1:8b
LLM_MODEL=
EMBEDDING_PROVIDER=fake
# [OPERATOR]
EMBEDDING_BASE_URL=
# [OPERATOR]
EMBEDDING_API_KEY=
# [OPERATOR] e.g. text-embedding-3-small, nomic-embed-text
EMBEDDING_MODEL=fake-embedding
# Vector column size is fixed by the FIRST migration. Choose before the first deploy (text-embedding-3-small=1536,
# nomic-embed-text=768). Changing it later requires a schema migration and re-embedding.
EMBEDDING_DIMENSIONS=384

# ---------------------------------------------------------------------------------------------- MCP (profile mcp)
# [OPERATOR] API key (agent role, workspace-scoped) the MCP server uses to call the API, and its default workspace.
MNEMOS_MCP_API_KEY=
MNEMOS_MCP_WORKSPACE_ID=

# ---------------------------------------------------------------------------------------------- backups
# Absolute path recommended in production (bootstrap uses /opt/mnemos/backups). Relative = relative to repo root.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Always keep at least this many newest backups, regardless of age.
BACKUP_KEEP_MIN=3
# Optional off-site copy hook: path of an executable run after each successful backup with BACKUP_FILE,
# BACKUP_MANIFEST, BACKUP_CHECKSUM and BACKUP_DIR exported (see docs/RUNBOOK.md "Off-site copies" for an rclone
# example). Keep `$` out of this file: compose interpolates it.
BACKUP_OFFSITE_CMD=

# ---------------------------------------------------------------------------------------------- resources
# Defaults target a 4 vCPU / 8 GB VPS. Sum of memory limits (excl. ollama) ~ 4.8 GB.
POSTGRES_CPUS=2.0
POSTGRES_MEM_LIMIT=2g
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=100
PG_SHM_SIZE=256m
REDIS_CPUS=0.5
REDIS_MEM_LIMIT=384m
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
API_CPUS=1.5
API_MEM_LIMIT=1g
WORKER_CPUS=1.5
WORKER_MEM_LIMIT=1g
WEB_CPUS=0.5
WEB_MEM_LIMIT=128m
CADDY_CPUS=0.5
CADDY_MEM_LIMIT=256m
MCP_CPUS=0.5
MCP_MEM_LIMIT=384m
OLLAMA_CPUS=2.0
OLLAMA_MEM_LIMIT=6g
# Container log rotation (json-file driver)
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
