# Mnemos development / CI baseline environment (safe, non-secret defaults).
# Production uses infra/env.production.example (see docs/RUNBOOK.md); never deploy these values.
#
# Hostnames below (postgres, redis) are the in-network names used by infra/docker-compose.dev.yml `app` profile.
# When running the backend on the host (`uv run mnemos api`) against the dev compose data services, use:
#   DATABASE_URL=postgresql+asyncpg://mnemos:mnemos@127.0.0.1:5433/mnemos
#   REDIS_URL=redis://127.0.0.1:6380/0
# (ports are configurable with DEV_PG_PORT / DEV_REDIS_PORT when starting the dev compose stack).
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mnemos:mnemos@postgres:5432/mnemos
REDIS_URL=redis://redis:6379/0
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=
ALLOWED_HOSTS=*
API_BOOTSTRAP_SECRET=change-me
API_KEY_PEPPER=
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIMENSIONS=384
WORKER_HEALTH_PORT=8001
# Dev compose host ports (loopback only)
DEV_PG_PORT=5433
DEV_REDIS_PORT=6380
DEV_API_PORT=8000
DEV_WEB_PORT=5173
